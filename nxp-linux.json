{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "VMUsername": {
            "type": "string",
            "defaultValue": "labuser"
        },
        "VMPassword": {
            "type": "securestring",
            "defaultValue": "Password.1!!"
        },
        "DeploymentID": {
            "type": "string"
        },
        "scriptFileName": {
            "type": "string",
            "defaultValue": "bashscript.sh"
        },
        "imgid": {
            "type": "string"
        },
        "disksize": {
            "type": "string",
            "defaultValue": "512"
        },
        "userEmail": {
            "type": "string"
        }
    },
    "variables": {
        "scriptFileUri": "https://cloudlabs-prod-templates-s3.s3.us-east-1.amazonaws.com/arrow/bashscript.sh",
        "vmName": "[concat('labvm-',parameters('DeploymentID'))]",
        "vmNetworkInterfaceName": "[concat('labvmnic-',parameters('DeploymentID'))]",
        "networkInterface2Name": "[concat('labvmnic2-',parameters('DeploymentID'))]",
        "publicIpAddressName": "[concat('labvmpip-',parameters('DeploymentID'))]",
        "publicIpDnsName": "[concat('labvmpip-', parameters('DeploymentID'))]",
        "networkSGroupName": "[concat('labvmnsg-', parameters('DeploymentID'))]",
        "vnetName": "arrow-azure-site-vnet",
        "subnetName": "/subscriptions/2b39737e-1727-4625-93f2-d5d6739f9a85/resourceGroups/arrow-s2s-vpn/providers/Microsoft.Network/virtualNetworks/arrow-azure-site-vnet/subnets/vm-subnet",
        "virtualMachineSize": "Standard_D8s_v5",
        "tenantId": "[subscription().tenantId]",
        "SubId": "[subscription().subscriptionId]"
    },
    "resources": [
        {
            "apiVersion": "2016-09-01",
            "name": "pid-e843308b-3ce2-42a2-b743-2f21b36a5e68",
            "type": "Microsoft.Resources/deployments",
            "properties": {
                "mode": "Incremental",
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "resources": []
                }
            }
        },
        {
            "type": "Microsoft.Compute/disks",
            "apiVersion": "2022-07-02",
            "name": "Labvm-OSDisk",
            "location": "[resourceGroup().location]",
            "sku": {
                "name": "Premium_LRS",
                "tier": "Premium"
            },
            "properties": {
                "osType": "Windows",
                "hyperVGeneration": "V2",
                "supportedCapabilities": {
                    "architecture": "x64"
                },
                "creationData": {
                    "createOption": "FromImage",
                    "imageReference": {
                        "id": "[parameters('imgid')]"
                    },
                    "galleryImageReference": {
                        "id": "[parameters('imgid')]"
                    }
                },
                "diskSizeGB": "[parameters('disksize')]",
                "diskIOPSReadWrite": 2300,
                "diskMBpsReadWrite": 150,
                "encryption": {
                    "type": "EncryptionAtRestWithPlatformKey"
                },
                "networkAccessPolicy": "AllowAll",
                "publicNetworkAccess": "Enabled",
                "diskState": "Reserved",
                "tier": "P20"
            }
        },
        {
            "name": "[variables('publicIpAddressName')]",
            "type": "Microsoft.Network/publicIPAddresses",
            "apiVersion": "2023-04-01",
            "location": "[resourceGroup().location]",
             "sku": {
                "name": "Standard"
            },
            "tags": {
                "displayName": "[variables('publicIpAddressName')]"
            },
            "properties": {
                "publicIPAllocationMethod": "Static",
                "dnsSettings": {
                    "domainNameLabel": "[variables('publicIpDnsName')]"
                }
            }
        },
        {
            "name": "[variables('networkSGroupName')]",
            "type": "Microsoft.Network/networkSecurityGroups",
            "apiVersion": "2023-04-01",
            "location": "[resourceGroup().location]",
            "properties": {
                "securityRules": [
                    {
                        "name": "nsgRule1",
                        "properties": {
                            "description": "description",
                            "protocol": "Tcp",
                            "sourcePortRange": "*",
                            "destinationPortRange": "22",
                            "sourceAddressPrefix": "*",
                            "destinationAddressPrefix": "*",
                            "access": "Allow",
                            "priority": 100,
                            "direction": "Inbound"
                        }
                    },
                    {
                        "name": "nsgRule2",
                        "properties": {
                            "description": "description",
                            "protocol": "Tcp",
                            "sourcePortRange": "*",
                            "destinationPortRange": "3389",
                            "sourceAddressPrefix": "*",
                            "destinationAddressPrefix": "*",
                            "access": "Allow",
                            "priority": 110,
                            "direction": "Inbound"
                        }
                    },
                    {
                        "name": "nsgRule3",
                        "properties": {
                            "description": "Shared Folder",
                            "protocol": "Tcp",
                            "sourcePortRange": "*",
                            "destinationPortRange": "8080",
                            "sourceAddressPrefix": "*",
                            "destinationAddressPrefix": "*",
                            "access": "Allow",
                            "priority": 120,
                            "direction": "Inbound"
                        }
                    }
                ]
            }
        },
        {
            "name": "[variables('vmNetworkInterfaceName')]",
            "type": "Microsoft.Network/networkInterfaces",
            "apiVersion": "2023-04-01",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName'))]",
                "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSGroupName'))]"
            ],
            "tags": {
                "displayName": "[variables('vmNetworkInterfaceName')]"
            },
            "properties": {
                "ipConfigurations": [
                    {
                        "name": "ipConfig1",
                        "properties": {
                            "privateIPAllocationMethod": "Dynamic",
                            "publicIPAddress": {
                                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName'))]"
                            },
                            "subnet": {
                                "id": "[variables('subnetName')]"
                            }
                        }
                    }
                ],
                "networkSecurityGroup": {
                    "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', variables('networkSGroupName'))]"
                }
            }
        },
        {
            "type": "Microsoft.Network/networkInterfaces",
            "name": "[variables('networkInterface2Name')]",
            "apiVersion": "2016-09-01",
            "location": "[resourceGroup().location]",
            "tags": {},
            "properties": {
                "ipConfigurations": [
                    {
                        "name": "ipconfig2",
                        "properties": {
                            "privateIPAllocationMethod": "Dynamic",
                            "subnet": {
                                "id": "[variables('subnetName')]"
                            }
                        }
                    }
                ],
                "networkSecurityGroup": {
                    "id": "[resourceId(resourceGroup().name, 'Microsoft.Network/networkSecurityGroups', variables('networkSGroupName'))]"
                }
            },
            "dependsOn": [
                "[concat('Microsoft.Network/networkInterfaces/', variables('vmNetworkInterfaceName'))]",
                "[concat('Microsoft.Network/networkSecurityGroups/', variables('networkSGroupName'))]"
            ]
        },
        {
            "name": "[variables('vmName')]",
            "type": "Microsoft.Compute/virtualMachines",
            "apiVersion": "2023-03-01",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Network/networkInterfaces', variables('vmNetworkInterfaceName'))]",
                "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterface2Name'))]"
            ],
            "tags": {
                "displayName": "[variables('vmName')]"
            },
            "properties": {
                "hardwareProfile": {
                    "vmSize": "[variables('virtualMachineSize')]"
                },
                "storageProfile": {
                    "osDisk": {
                        "createOption": "Attach",
                        "osType": "Linux",
                        "managedDisk": {
                            "id": "[concat('/subscriptions/', subscription().subscriptionId,'/resourceGroups/',resourceGroup().Name,'/providers/Microsoft.Compute/disks/Labvm-OSDisk')]"
                        }
                    }
                },
                "networkProfile": {
                    "networkInterfaces": [
                        {
                            "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('vmNetworkInterfaceName'))]",
                            "properties": {
                                "primary": true,
                                "deleteOption": "Detach"
                            }
                        },
                        {
                            "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterface2Name'))]",
                            "properties": {
                                "primary": false
                            }
                        }
                    ]
                }
            }
        },
        {
            "type": "Microsoft.Compute/virtualMachines/extensions",
            "name": "[concat(variables('vmName'), '/customScript')]",
            "apiVersion": "2023-03-01",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]"
            ],
            "tags": {
                "displayName": "VM Extension"
            },
            "properties": {
                "publisher": "Microsoft.Azure.Extensions",
                "type": "CustomScript",
                "typeHandlerVersion": "2.1",
                "autoUpgradeMinorVersion": true,
                "settings": {
                    "fileUris": [
                        "[variables('scriptFileUri')]"
                    ]
                },
                "protectedSettings": {
                    "commandToExecute": "[concat('bash bashscript.sh ', parameters('userEmail'), ' ', parameters('DeploymentID'), ' ', reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpAddressName'))).dnsSettings.fqdn)]"
                }
            }
        }
    ],
    "outputs": {
        "VMDNSname": {
            "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses',variables('publicIpAddressName'))).dnsSettings.fqdn]",
            "type": "string"
        },
        "VMUsername": {
            "type": "string",
            "value": "[parameters('VMUsername')]"
        },
        "VMPassword": {
            "type": "string",
            "value": "[parameters('VMPassword')]"
        },
        "DeploymentID": {
            "type": "string",
            "value": "[parameters('DeploymentID')]"
        }
    }
}
